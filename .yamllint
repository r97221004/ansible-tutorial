---
# yamllint configuration (consumed by ansible-lint and standalone `yamllint .`)
extends: default

ignore: |
  .git/
  # Encrypted Vault file is not plain YAML and has no document start.
  ansible/inventory/group_vars/control/vault.yml

rules:
  # Playbooks use long descriptive strings and inline URLs; don't enforce a hard cap.
  line-length: disable
  # Ansible truthy values like `true`/`false` are already consistent.
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  # The following must match ansible-lint's internal requirements.
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
